{
  "name": "@workeryard/underfetch",
  "version": "0.1.0",
  "description": "HTTP over raw sockets for Cloudflare Workers: SOCKS and HTTP(S) proxies, TLS in WebAssembly, HTTP/1.1 and HTTP/2, and a handshake that can look like Chrome, Firefox or Safari.",
  "type": "module",
  "license": "MIT",
  "author": "0x4d4d4f (https://github.com/0x4d4d4f)",
  "homepage": "https://github.com/workeryard/underfetch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workeryard/underfetch.git"
  },
  "bugs": {
    "url": "https://github.com/workeryard/underfetch/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "socks5",
    "proxy",
    "tls",
    "fetch",
    "http-connect",
    "fingerprint",
    "http2",
    "workerd",
    "browser-impersonation",
    "ja4"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./workers": "./src/workers/index.ts",
    "./wasm": "./src/tls/wasm.ts"
  },
  "files": [
    "src",
    "rust-tls/pkg",
    "rust-tls/src",
    "rust-tls/Cargo.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:wasm": "cd rust-tls && wasm-pack build --target web --out-dir pkg --out-name underfetch_tls",
    "verify": "tsx scripts/verify.ts",
    "verify:live": "wrangler dev --port 8799",
    "import:browsers": "tsx scripts/import-browsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
