{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "underfetch-verify",
  "main": "dev/worker.ts",
  "compatibility_date": "2026-09-21",
  // The TLS module arrives as a WebAssembly.Module, which is how `src/tls/wasm.ts`
  // expects it; without this rule the import is a URL and nothing works.
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallback": true }],
  // Where /state/save keeps a session for /state/load, across restarts of the
  // dev server: local only, never deployed anywhere.
  "kv_namespaces": [{ "binding": "STATE", "id": "underfetch-dev-state" }],
}
